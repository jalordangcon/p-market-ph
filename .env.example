# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYMENT GATEWAY INTEGRATION (GCash & Maya via PayMongo / Maya Enterprise)
# In development/demo, the system runs in Sandbox Test Mode.
# To switch to Live Payments with Bangko Sentral ng Pilipinas (BSP) regulated accounts:
PAYMENT_GATEWAY_SECRET_KEY="sk_live_YOUR_PAYMONGO_OR_MAYA_SECRET_KEY"
PAYMENT_PUBLIC_KEY="pk_live_YOUR_PAYMONGO_OR_MAYA_PUBLIC_KEY"
PAYMENT_WEBHOOK_SECRET="whsec_YOUR_HMAC_WEBHOOK_SIGNING_SECRET"

# SESSION SECRET: Key used for signing cryptographic session tokens
SESSION_SECRET="pmarket_ph_production_session_signing_secret"
